{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memory Vault",
  "version": "0.2.0",
  "identifier": "com.shahbaz242630.memory-vault",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Memory Vault",
        "width": 900,
        "height": 700,
        "minWidth": 900,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "category": "Productivity",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "shortDescription": "A private, on-device memory vault for your AI agents.",
    "longDescription": "Memory Vault is a personal, user-owned memory layer for AI assistants. Your memories stay on your own device and are encrypted at rest — any AI agent you connect reads from one private vault you control.",
    "resources": {
      "../vault-embedding/test-fixtures/bge-small-en-v1.5/onnxruntime.dll": "libs/onnxruntime.dll",
      "../vault-embedding/test-fixtures/bge-small-en-v1.5/model.onnx": "models/model.onnx",
      "../vault-embedding/test-fixtures/bge-small-en-v1.5/tokenizer.json": "models/tokenizer.json"
    },
    "windows": {
      "wix": {
        "fragmentPaths": ["./windows/fragments/installer.wxs"],
        "componentRefs": ["SetLanceMemPoolEnv", "VaultCliBinary", "VaultMaintenanceBinary", "AddInstallDirToPath"]
      }
    }
  }
}
